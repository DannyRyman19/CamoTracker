<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".CamoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_legacy"
        android:label="Camo Track"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- mw4camo://mode/<mode>[/weapon/N | /event/C/I | /events/C][?game=x] (DeepLink.kt) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mw4camo" android:host="mode" />
            </intent-filter>
        </activity>
        <!-- The launcher icons: the usual one, and each camo icon a player can earn
             (AppIcons.kt switches which alias is enabled). Made by tools/make_icons.py. -->
        <activity-alias android:name=".IconDefault" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconGold" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_gold" android:roundIcon="@mipmap/ic_launcher_gold">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconPlatinum" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_platinum" android:roundIcon="@mipmap/ic_launcher_platinum">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconHarmonicBreak" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_harmonic_break" android:roundIcon="@mipmap/ic_launcher_harmonic_break">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconDivergence" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_divergence" android:roundIcon="@mipmap/ic_launcher_divergence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconMercurialDrift" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_mercurial_drift" android:roundIcon="@mipmap/ic_launcher_mercurial_drift">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconPolyatomicReforged" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_polyatomic_reforged" android:roundIcon="@mipmap/ic_launcher_polyatomic_reforged">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconOrionReforged" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_orion_reforged" android:roundIcon="@mipmap/ic_launcher_orion_reforged">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconParallax" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_parallax" android:roundIcon="@mipmap/ic_launcher_parallax">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconDamascusReforged" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_damascus_reforged" android:roundIcon="@mipmap/ic_launcher_damascus_reforged">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconEmpyros" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_empyros" android:roundIcon="@mipmap/ic_launcher_empyros">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconChiral" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_chiral" android:roundIcon="@mipmap/ic_launcher_chiral">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconRippleTide" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_ripple_tide" android:roundIcon="@mipmap/ic_launcher_ripple_tide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconHelio" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_helio" android:roundIcon="@mipmap/ic_launcher_helio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconFlashpoint" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_flashpoint" android:roundIcon="@mipmap/ic_launcher_flashpoint">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- The home-screen widgets (widgets/Widgets.kt), and setting one up (its game, and Mode progress's mode) -->
        <receiver android:name=".widgets.PinnedWeaponReceiver" android:exported="true" android:label="@string/widget_pinned_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pinned" />
        </receiver>
        <receiver android:name=".widgets.ModeProgressReceiver" android:exported="true" android:label="@string/widget_mode_progress_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mode_progress" />
        </receiver>
        <receiver android:name=".widgets.CompletionReceiver" android:exported="true" android:label="@string/widget_completion_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_completion" />
        </receiver>
        <activity android:name=".widgets.WidgetConfigActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar" android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
