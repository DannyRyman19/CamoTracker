# Signing material. The TestFlight workflow decodes secrets into these paths on
# the runner, and a local `fastlane beta` does the same, so keep them out of git.
*.p12
*.p8
AuthKey_*.p8
**/fastlane/dist_cert.p12
**/fastlane/AuthKey.p8
**/fastlane/report.xml
**/fastlane/README.md

# Xcode build output (357 MB of derived data under MW4CamoTracker/build alone)
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Resolved fresh on CI. A lockfile written by macOS system Ruby (2.6) pins
# "BUNDLED WITH 1.17.2", and setup-ruby honours it -- bundler 1.17 calls
# String#untaint, removed in Ruby 3.2, so the runner dies before it builds.
Gemfile.lock

# Regenerated by Tools/screenshots/make.sh; 14 MB of derived PNGs that would
# churn binary history on every run. The metadata lane skips them if absent.
MW4CamoTracker/fastlane/screenshots/

# App Review contact number. Kept out of git: deliver reads it from disk at
# upload time, so it only needs to exist on the machine running the lane.
MW4CamoTracker/fastlane/metadata/review_information/phone_number.txt
