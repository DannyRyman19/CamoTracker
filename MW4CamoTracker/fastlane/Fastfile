# MW4 Camo Tracker - CI archive + TestFlight upload.
#
# Runs on a GitHub-hosted macOS runner (see .github/workflows/testflight.yml).
# Auth is an App Store Connect API key; the distribution certificate is
# imported from a base64 secret into a throwaway CI keychain. The provisioning
# profile is created/refreshed on the fly through the same API key, so there is
# no second "certificates" repo to keep in sync the way `match` needs.
#
# Simpler than the Vinewood Vault lane this is modelled on: one target, no app
# extension (so no second profile and no CFBundleVersion to keep in step), and
# the .xcodeproj is committed rather than generated, so there is no xcodegen
# step to run first.

default_platform(:ios)

APP_IDENTIFIER = "com.DannyRyman.MW4CamoTracker"
PROFILE_NAME   = "MW4 Camo Tracker CI App Store"
XCODE_PROJECT  = "MW4CamoTracker.xcodeproj"
XCODE_SCHEME   = "MW4CamoTracker"
TEAM_ID        = "44G72CWWEW"

platform :ios do
  desc "Archive a Release build and ship it to TestFlight"
  lane :beta do
    # On CI (CI=true) this makes a temporary keychain and marks it default,
    # exporting MATCH_KEYCHAIN_NAME / MATCH_KEYCHAIN_PASSWORD. No-op locally.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),   # base64 of the AuthKey_XXXX.p8
      is_key_content_base64: true,
      in_house: false
    )

    # Distribution certificate -> CI keychain. The workflow decodes
    # DIST_CERT_P12 to fastlane/dist_cert.p12 just before this lane runs.
    if is_ci
      import_certificate(
        certificate_path: File.expand_path("dist_cert.p12", __dir__),
        certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
        keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
      )
    end

    version = ENV["APP_VERSION"].to_s.strip
    version = get_version_number(xcodeproj: XCODE_PROJECT, target: XCODE_SCHEME) if version.empty?

    # One above the highest build already on TestFlight for the whole app,
    # deliberately NOT scoped to this version string. App Store Connect
    # normalises version numbers, so builds uploaded as "1.0.0" collide with
    # "1.0" - but a per-version lookup finds nothing under "1.0", resets to 1
    # and the upload is rejected as a redundant binary. Counting app-wide
    # means the number only ever goes up, which is all Apple requires.
    build_number = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      initial_build_number: 0
    ) + 1

    UI.important("Building #{version} (#{build_number})")

    # Fetch (creating if absent) an App Store provisioning profile via the
    # API. This is the reliable path -- `xcodebuild -exportArchive
    # -allowProvisioningUpdates` throws "Cloud signing permission error" even
    # with a valid App Manager key. The name is pinned so the export below can
    # reference it without guessing an env var.
    get_provisioning_profile(
      api_key: api_key, app_identifier: APP_IDENTIFIER,
      provisioning_name: PROFILE_NAME,
      fail_on_name_taken: false, readonly: false
    )

    # The archive signs manually, against the profile fetched just above.
    # It used to archive under `-allowProvisioningUpdates` with the project's
    # automatic signing, and because every CI run starts on a fresh empty
    # keychain, each one provisioned itself a NEW development certificate.
    # The sibling VinewoodVault app filled its account cap that way (ten
    # "Created via API" certificates) until the archive started failing with
    # "Choose a certificate to revoke". Nothing here can mint one now.
    #
    # This app has a single target, so these settings can be passed as build
    # settings for the whole archive without needing per-target pinning.
    signing = "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
              "PROVISIONING_PROFILE_SPECIFIER=\"#{PROFILE_NAME}\""

    build_app(
      project: XCODE_PROJECT,
      scheme: XCODE_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "#{signing} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: "",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { APP_IDENTIFIER => PROFILE_NAME }
      },
      output_directory: "build",
      output_name: "MW4CamoTracker.ipa",
      clean: true
    )

    # A changelog forces fastlane to wait for the build to appear on ASC (so
    # it can attach it), which adds ~5 min of runner time. Only pay that when
    # a changelog was actually supplied via "Run workflow"; otherwise
    # skip_waiting truly skips and testers see notes once processing ends.
    changelog = ENV["CHANGELOG"].to_s.strip
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: changelog.empty? ? nil : changelog
    )

    UI.success("#{version} (#{build_number}) uploaded. It appears in TestFlight once Apple finishes processing.")
  end

  desc "Attach a build to the current version and submit it for review"
  lane :submit do |options|
    #   bundle exec fastlane submit build:4
    #
    # Metadata and screenshots come from the `metadata` lane; this only
    # attaches a build and submits. Release stays MANUAL, so approval does
    # not put it on sale and there is a deliberate moment to look first.
    build = options[:build].to_s.strip
    UI.user_error!("pass the build, e.g. `fastlane submit build:4`") if build.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      build_number: build,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: {
        # Info.plist declares ITSAppUsesNonExemptEncryption false, and the app
        # has no ads, no ATT prompt and no ad identifier.
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )

    UI.success("Build #{build} submitted for review. Release is manual.")
  end

  desc "Push App Store listing text and screenshots (no binary)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    # Screenshots are optional so this lane still works before
    # Tools/screenshots/make.sh has been run.
    shots = File.expand_path("screenshots", __dir__)
    has_shots = Dir.exist?(shots) && !Dir.glob("#{shots}/**/*.png").empty?
    UI.important("No screenshots in fastlane/screenshots, skipping those") unless has_shots

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: !has_shots,
      overwrite_screenshots: has_shots,
      # Nothing here submits for review; it only updates the draft listing.
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
