		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d Bauplan eingesammelt</string>
			<key>other</key>
			<string>%d Baupläne eingesammelt</string>
		</dict>
	</dict>
