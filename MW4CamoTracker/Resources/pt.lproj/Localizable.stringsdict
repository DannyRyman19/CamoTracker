		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Mais %d sugestão com o Premium</string>
			<key>other</key>
			<string>Mais %d sugestões com o Premium</string>
		</dict>
	</dict>
