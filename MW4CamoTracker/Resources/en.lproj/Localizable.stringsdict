<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>mw4.ui.postmatch.blueprints</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d blueprint picked up</string>
			<key>other</key>
			<string>%d blueprints picked up</string>
		</dict>
	</dict>
	<key>mw4.ui.premium.more_suggestions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d more suggestion with Premium</string>
			<key>other</key>
			<string>%d more suggestions with Premium</string>
		</dict>
	</dict>
	<key>mw4.ui.hajin.scan_updated</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Updated %d item from your photos</string>
			<key>other</key>
			<string>Updated %d items from your photos</string>
		</dict>
	</dict>
	<key>ct.import.done</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Imported progress for %d weapon.</string>
			<key>other</key>
			<string>Imported progress for %d weapons.</string>
		</dict>
	</dict>
	<key>mw4.ui.postmatch.unread</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d tile couldn't be read (a weapon or some gear)</string>
			<key>other</key>
			<string>%d tiles couldn't be read (weapons and some gear)</string>
		</dict>
	</dict>
	<key>mw4.ui.milestone.final_many</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d weapon has it now.</string>
			<key>other</key>
			<string>%d weapons have it now.</string>
		</dict>
	</dict>
	<key>ct.ui.suggestion.camos_left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d camo to complete</string>
			<key>other</key>
			<string>%d camos to complete</string>
		</dict>
	</dict>
</dict>
</plist>
